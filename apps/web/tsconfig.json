{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "env.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "#astro-components/*": ["./src/components/astro/*.astro"],
      "#utils/*": ["./src/js/utils/*"],
      "#api/*": ["./src/js/api/*"],
      "#assets/*": ["./src/assets/*"]
    }
  }
}
